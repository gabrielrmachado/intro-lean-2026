*.bbl
*.bcf
*.blg
*-blx.aux
*-blx.bib
*.run.xml

# ==============================================================================
# Classes Específicas: Apresentações Beamer
# ==============================================================================
*.nav
*.snm
*.vrb

# ==============================================================================
# Pacotes Avançados: Código (Minted), Gráficos (TikZ), Glossários
# ==============================================================================
_minted-*/
*.dpth
*.md5
*.auxlock
*.tikz
*.figlist
*.makefile
*.acn
*.acr
*.alg
*.glg
*.glo
*.gls
*.ist

# ==============================================================================
# Artefatos Binários (PDFs)
# ==============================================================================
# Descomente a linha abaixo para impedir o versionamento de qualquer PDF.
# Recomendado: O Git lida mal com binários que mudam frequentemente. 
# O PDF deve ser gerado localmente ou por uma pipeline de CI, não rastreado no Git.
# *.pdf
